{
  "name": "conduit-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework with UI, API and hybrid tests for the Conduit (RealWorld) app",
  "private": true,
  "scripts": {
    "test": "playwright test --project=api --project=chromium",
    "test:all": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --project=chromium --project=firefox",
    "test:smoke": "playwright test --project=api --project=chromium --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://conduit.bondaracademy.com",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "typescript": "^7.0.2"
  }
}
